---
import Base from "../../layouts/Base.astro";
// import GlitchEffect from "@assets/glitch.svg";
import GlitchEffect from "../../assets/glitch.svg";
import Project from "../../components/Project.astro";
import pic from "@assets/pic1.png";
---
<Base>
    <section class="projects">
        <h2 class="projects__title">Projects</h2>
        <div class="projects__list">
            <Project title="1" imgPath={pic.src} />
            <Project title="2" imgPath={pic.src} />
            <Project title="2024 Sound NeuroscienceOfAesthetics" imgPath={pic.src} />
            <Project title="4" imgPath={pic.src} />
            <Project title="5" imgPath={pic.src} />
            <Project title="6" imgPath={pic.src} />
            <Project title="7" imgPath={pic.src} />
        </div>
    </section>
    <GlitchEffect />
</Base>

<style>
    .projects {
        max-width: var(--wide-width);
        margin: 0 auto;
    }

    .projects__title {
        font-family: var(--font-serif);
        font-size: var(--font-size-2xl);
        font-weight: 500;
        line-height: 1.2;
        margin-bottom: var(--spacing-lg);
    }

    .projects__list {
        display: grid;
        /* min 300px wide */
        grid-template-columns: repeat(auto-fit, minmax(calc(300 / 16 * 1rem), 1fr));
        gap: var(--spacing-lg);
    }
</style>