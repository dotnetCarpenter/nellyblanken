---
import { getImage } from "astro:assets";

const { imgPath, title, year, sponsors } = Astro.props;
const imgSrc = await getImage({ src: imgPath, format: "webp" });

const random = (min:number, max:number) => (Math.random() * (max - min)).toFixed(2);
---
<article class="project" style={`--data-random1: ${random(0,5)};--data-random2: ${random(0,5)};`}>
    <h3 class="project__title">{title}</h3>
    {sponsors?.logo && <img class="project__sponsors" src={sponsors.logo} alt="{sponsors.name}" />}
    <picture class="project__image">
        <!-- <img src={imgSrc.src} alt={title} width={300} height={240} /> -->
        <div class="glitch-image project--color-filter" style={`background-image: url("${imgSrc.src}");`}></div>
        <div class="glitch-image grainy" style={`background-image: url("${imgSrc.src}");`}></div>
        <div class="glitch-image offset project--color-filter" style={`background-image: url("${imgSrc.src}");`}></div>
        <div class="glitch-image offset project--color-filter" style={`background-image: url("${imgSrc.src}");`}></div>
        <div class="glitch-image grainy" style={`background-image: url("${imgSrc.src}");`}></div>
        <!-- <div class="glitch-image outro"></div> -->
        <p class="project__year">{year}</p>
    </picture>
</article>

<style>
.project {
    position: relative;

    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: min-content 1fr;
    grid-template-areas:
    "title"
    "image";
    align-items: end;

    height: calc(300 / 16 * 1rem);

    font-optical-sizing: auto;

    .project__year {
        position: absolute;
        top: 0;
        right: 0rem;

        margin: -.6rem .6rem 0 0;

        font-weight: bold;
        font-size: var(--font-size-3xl);
        -webkit-text-stroke: 1px var(--color-text);
        color: transparent;

        @media (prefers-color-scheme: dark) {
            mix-blend-mode: hard-light;
        }
        @media (prefers-color-scheme: light) {
            filter: url("#purple");
        }

        /* -webkit-text-stroke: 1px contrast-color(var(--color-text)); */

        /* filter: invert(1); */
        /* filter: contrast(175%); */

        /* background-color: black; */
        /* background-clip: text; */
    }

    .project__title {
        /* position-anchor: project-image; */
        grid-area: title;

        display:flex;
        align-items: end;
        margin-bottom: .1rem;

        height: calc(60 / 16 * 1rem);

        word-wrap: break-word;
        word-break: break-all;

        @media (prefers-color-scheme: light) {
            mix-blend-mode: difference;
            filter: invert(1);
        }
    }

    .project__image {
        /* anchor-name: project-image; */
        grid-area: image;
        align-self: end;
        position: relative;
        height: calc(240 / 16 * 1rem);

        border-radius: 0 .4rem;
    }

    .project--color-filter {
        filter: url("#purple");
    }

    .glitch-image {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;

        background-size: cover;
        background-position: center;
        border-radius: 0 0.4rem;
        /* mix-blend-mode: normal; */
    }
}

.glitch-image:nth-child(2) {
    animation: 3s glitch-horizontal calc(var(--data-random1) * 1s) infinite linear alternate;
}
 .glitch-image:nth-child(3) {
    animation: 2s glitch-horizontal-2 calc(var(--data-random2) * 1s) infinite linear alternate;
}
.glitch-image:nth-child(4) {
    animation: random(3s, 6s) glitch-flash-2 calc(var(--data-random1) * 0.5s) infinite linear alternate;
}
.glitch-image:nth-child(5) {
    animation: random(0.1s, .5s) glitch-flash calc(var(--data-random2) * 0.5s) steps(1, end) infinite;
}
.grainy {
    filter: url("#purple") url("#noise");
    opacity: .5;
}
.offset {
    mix-blend-mode: soft-light;
}
.offset:nth-of-type(odd) {
    filter: url("#cyan");
}
.offset:nth-of-type(even) {
    filter: url("#magenta");
}
.outro {
    animation: outro 5s linear;
    animation-fill-mode: forwards;
    filter: url("#cyan");
}

@keyframes outro {
    0%,
    80% {
        opacity: 0;
    }
    84% {
        opacity: 1;
    }
    85% {
        opacity: 0;
    }
    90%,
    100% {
        opacity: 1;
        border-color: rgba(19, 226, 226, 0.8);
    }
}
@keyframes intro {
    0% {
        opacity: 1;
    }
    10%,
    100% {
        opacity: 0;
        border-color: rgba(204, 49, 158, 0.6);
    }
}

@keyframes glitch-horizontal {
    0% {
        clip-path: polygon(0 2%, 100% 2%, 100% 5%, 0 5%);
    }
    10% {
        clip-path: polygon(0 15%, 100% 15%, 100% 15%, 0 15%);
    }
    20% {
        clip-path: polygon(0 10%, 100% 10%, 100% 20%, 0 20%);
    }
    30% {
        clip-path: polygon(0 1%, 100% 1%, 100% 2%, 0 2%);
    }
    40% {
        clip-path: polygon(0 33%, 100% 33%, 100% 33%, 0 33%);
    }
    50% {
        clip-path: polygon(0 44%, 100% 44%, 100% 44%, 0 44%);
    }
    60% {
        clip-path: polygon(0 50%, 100% 50%, 100% 20%, 0 20%);
    }
    70% {
        clip-path: polygon(0 70%, 100% 70%, 100% 70%, 0 70%);
    }
    80% {
        clip-path: polygon(0 80%, 100% 80%, 100% 80%, 0 80%);
    }
    90% {
        clip-path: polygon(0 50%, 100% 50%, 100% 55%, 0 55%);
    }
    100% {
        clip-path: polygon(0 70%, 100% 70%, 100% 80%, 0 80%);
    }
}

@keyframes glitch-horizontal-2 {
    0% {
        opacity: 1;
        /* transform: translate3d(-10px, 0, 0); */
        clip-path: polygon(0 25%, 100% 25%, 100% 30%, 0 30%);
    }
    3% {
        clip-path: polygon(0 3%, 100% 3%, 100% 3%, 0 3%);
    }
    5% {
        clip-path: polygon(0 5%, 100% 5%, 100% 20%, 0 20%);
    }
    7% {
        clip-path: polygon(0 20%, 100% 20%, 100% 20%, 0 20%);
    }
    9% {
        clip-path: polygon(0 40%, 100% 40%, 100% 40%, 0 40%);
    }
    11% {
        clip-path: polygon(0 52%, 100% 52%, 100% 59%, 0 59%);
    }
    13% {
        clip-path: polygon(0 60%, 100% 60%, 100% 60%, 0 60%);
    }
    15% {
        clip-path: polygon(0 75%, 100% 75%, 100% 75%, 0 75%);
    }
    17% {
        clip-path: polygon(0 65%, 100% 65%, 100% 40%, 0 40%);
    }
    19% {
        clip-path: polygon(0 45%, 100% 45%, 100% 50%, 0 50%);
    }
    20% {
        clip-path: polygon(0 14%, 100% 14%, 100% 33%, 0 33%);
    }
    21.9% {
        opacity: 1;
        /* transform: translate3d(-10px, 0, 0); */
    }
    22%,
    100% {
        opacity: 0;
        /* transform: translate3d(0, 0, 0); */
        clip-path: polygon(0 0, 0 0, 0 0, 0 0);
    }
}

@keyframes glitch-flash {
    0% {
        opacity: 0.2;
        transform: translate3d(3px, 2px, 0);
    }
    33%,
    100% {
        opacity: 0;
        transform: translate3d(0, 0, 0);
    }
}

@keyframes glitch-flash-2 {
    0% {
        opacity: 0.2;
        transform: translate3d(3px, 7px, 0);
    }
    13%,
    100% {
        opacity: 0;
        transform: translate3d(0, 0, 0);
    }
}
</style>